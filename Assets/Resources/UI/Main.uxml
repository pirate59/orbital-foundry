<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">

        <ui:VisualElement name="top-bar" class="top-bar">
            <ui:Label name="currency-label" class="stat stat-currency stat-tight" text="Credits: 0" />
            <ui:Label name="sale-credit-gain" class="sale-credit-gain" text="" picking-mode="Ignore" />
            <ui:Button name="help-ion" class="help-q help-wire stat-help" text="?" />
            <ui:Label name="power-label" class="stat stat-power stat-tight" text="Power" />
            <ui:Button name="help-power" class="help-q help-wire stat-help" text="?" />
            <ui:VisualElement class="income-group">
                <ui:Label name="sales-label" class="stat stat-income stat-tight" text="Income" />
                <ui:Button name="help-credits" class="help-q help-wire stat-help" text="?" />
            </ui:VisualElement>
            <ui:VisualElement name="trade-hold" class="trade-hold">
                <ui:VisualElement class="trade-hold-track">
                    <ui:VisualElement name="trade-hold-fill" class="trade-hold-fill" />
                </ui:VisualElement>
                <ui:Label name="trade-hold-label" class="trade-hold-label" text="" />
            </ui:VisualElement>
            <ui:Label name="goal-label" class="stat goal" text="Goals: Sales not yet  ·  AI HQ standing" />
            <ui:VisualElement class="spacer" picking-mode="Ignore" />
            <ui:Label name="save-indicator" class="save-indicator" text="Not saved yet" />
            <ui:Label name="speed-label" class="speed-label" text="" />
            <ui:VisualElement name="speed-cluster" class="speed-cluster">
                <ui:Button name="top-speed-pause" class="tool speed-chip speed-pause" text="Pause [Space]" />
                <ui:Button name="top-speed-1" class="tool speed-chip" text="1x" />
                <ui:Button name="top-speed-2" class="tool speed-chip" text="2x" />
                <ui:Button name="top-speed-4" class="tool speed-chip" text="4x" />
            </ui:VisualElement>
            <ui:Button name="top-research" class="tool top-research" text="" />
            <ui:Button name="undo-button" class="tool undo-button" text="Undo [Ctrl+Z]" />
            <ui:Button name="production-button" class="tool production-button" text="Production [P]" />
            <ui:Button name="belt-view-button" class="tool belt-view-button" text="Belt View [V]" />
            <ui:Button name="menu-button" class="tool menu-button" text="Menu [Esc]" />
            <ui:Button name="intro-toggle" class="tool intro-toggle" text="Guide" />
        </ui:VisualElement>

        <ui:VisualElement name="intro-guide" class="intro-guide panel">
            <ui:VisualElement class="title-row">
                <ui:Label name="intro-heading" class="panel-title intro-heading" text="SIGNAL RELAY" />
                <ui:Button name="intro-hide" class="panel-toggle" text="Hide" />
            </ui:VisualElement>
            <ui:Label name="intro-instruction" class="intro-instruction" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="tactical-banner" class="tactical-banner">
            <ui:Label text="BATTLE IN PROGRESS - THE BESIEGED CELL STOPS PRODUCING" class="tactical-banner-text" />
        </ui:VisualElement>

        <ui:VisualElement class="columns" picking-mode="Ignore">
            <ui:VisualElement name="left-column" class="column left-column" picking-mode="Ignore">
                <ui:VisualElement name="build-panel" class="panel">
                    <ui:VisualElement class="title-row">
                        <ui:Label text="BUILD" class="panel-title" />
                        <ui:Button name="build-collapse" class="panel-toggle" text="Hide" />
                    </ui:VisualElement>
                    <ui:VisualElement name="build-tools">
                        <ui:Button name="select-tool" class="tool" text="Select  [Esc]" />
                        <ui:Button name="build-extractor" class="tool" text="Extractor" />
                        <ui:Button name="build-refinery" class="tool" text="Refinery" />
                        <ui:Button name="build-assembler" class="tool" text="Assembler" />
                        <ui:Button name="build-depot" class="tool" text="Sale Depot" />
                        <ui:Button name="build-shipyard" class="tool" text="Shipyard" />
                        <ui:Button name="build-fort" class="tool" text="Fort Construction Zone" />
                        <ui:Button name="build-storage" class="tool" text="Storage" />
                        <ui:Button name="build-purifier" class="tool" text="Water Purifier" />
                        <ui:Button name="build-solar" class="tool" text="Solar Array" />
                        <ui:Button name="build-drone-pad" class="tool" text="Drone Pad" />
                        <ui:Button name="belt-tool" class="tool" text="Belt (drag)" />
                        <ui:Button name="route-tool" class="tool" text="Auto belt (pick two machines)  [N]" />
                        <ui:Button name="dismantle-tool" class="tool danger" text="Dismantle  [X]" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="spacer" picking-mode="Ignore" />

            <ui:VisualElement name="right-column" class="column right-column" picking-mode="Ignore">
                <ui:ScrollView name="selection-panel" class="panel selection-panel">
                    <ui:VisualElement name="selection-title-row" class="title-row">
                        <ui:Label text="SELECTION" class="panel-title" />
                        <ui:Button name="selection-collapse" class="panel-toggle" text="Hide" />
                    </ui:VisualElement>
                    <ui:VisualElement name="selection-body">
                        <ui:Label name="selected-cell-label" class="body-text" text="Nothing selected. Click a cell, machine or craft." />
                        <ui:Label name="extractor-resource" class="extractor-resource" text="" />
                        <ui:VisualElement name="machine-status" class="machine-status">
                            <ui:Label name="machine-status-title" class="machine-status-title" text="" />
                            <ui:Label name="machine-status-action" class="machine-status-action" text="" />
                        </ui:VisualElement>
                        <ui:Label name="selection-details" class="body-text small" text="" />
                        <ui:VisualElement name="priority-panel">
                            <ui:Label text="DELIVERY PRIORITY" class="panel-subtitle" />
                            <ui:VisualElement class="priority-row">
                                <ui:Button name="priority-very_low" class="priority-button" text="V.Low" />
                                <ui:Button name="priority-low" class="priority-button" text="Low" />
                                <ui:Button name="priority-normal" class="priority-button" text="Normal" />
                                <ui:Button name="priority-high" class="priority-button" text="High" />
                                <ui:Button name="priority-very_high" class="priority-button" text="V.High" />
                            </ui:VisualElement>
                            <ui:Label name="priority-hint" class="body-text small" text="" />
                        </ui:VisualElement>
                        <ui:Button name="config-open" class="tool primary" text="Settings  [C]" />
                        <ui:Button name="research-button" class="tool primary" text="Research" />
                        <ui:Label name="availability-title" class="panel-subtitle" text="AVAILABLE RESOURCES" />
                        <ui:Label name="availability-details" class="body-text small" text="" />
                        <ui:Label name="needs-title" class="panel-subtitle" text="NEEDS" />
                        <ui:VisualElement name="needs-list" class="needs-list" />
                        <ui:VisualElement name="craft-list" class="craft-list" />
                        <ui:Label name="selected-craft-stats" class="stats-text" text="" />
                        <ui:VisualElement name="craft-orders" class="craft-orders">
                            <ui:Label text="UNIT ORDERS" class="panel-subtitle" />
                            <ui:Label name="craft-order-hint" class="body-text small" text="" />
                            <ui:Button name="claim-button" class="tool primary" text="Claim this cell" />
                            <ui:Button name="repair-button" class="tool" text="Return for repairs" />
                            <ui:Button name="group-all-button" class="tool" text="Select all my units here" />
                            <ui:Button name="group-clear-button" class="tool" text="Clear group" />
                        </ui:VisualElement>
                        <ui:Button name="pad-link-button" class="tool primary" text="Link to another asteroid" />
                        <ui:Button name="pad-unlink-button" class="tool" text="Remove link" />
                        <ui:Button name="belt-upgrade-line" class="tool primary" text="Upgrade line" />
                        <ui:Button name="belt-upgrade-one" class="tool" text="Upgrade this belt" />
                        <ui:Button name="dismantle-button" class="tool danger" text="Dismantle" />
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:VisualElement name="alert-panel" class="panel">
                    <ui:VisualElement class="title-row">
                        <ui:Label text="ALERTS" class="panel-title" />
                        <ui:Button name="alert-collapse" class="panel-toggle" text="Hide" />
                    </ui:VisualElement>
                    <ui:ScrollView name="alert-list" class="alert-list" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="bottom-area" class="bottom-area" picking-mode="Ignore">
            <ui:VisualElement name="tactical-panel" class="panel tactical-panel">
                <ui:VisualElement class="tactical-row">
                    <ui:Label name="turn-label" class="turn-label" text="Your turn" />
                    <ui:Label name="action-label" class="action-label" text="Actions: 3" />
                    <ui:Button name="help-crafts" class="help-q help-wire" text="?" />
                </ui:VisualElement>
                <ui:Label name="attack-preview" class="preview-text" text="Select one of your craft, then hover an enemy cell to preview an attack." />
                <ui:VisualElement name="battle-lists" class="battle-lists">
                    <ui:VisualElement class="battle-col">
                        <ui:Label class="panel-subtitle" text="YOUR SHIPS" />
                        <ui:ScrollView name="ship-list" class="battle-list" />
                    </ui:VisualElement>
                    <ui:VisualElement class="battle-col">
                        <ui:Label name="target-title" class="panel-subtitle" text="TARGETS" />
                        <ui:ScrollView name="target-list" class="battle-list" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="pending-defender" class="pending-defender" />
                <ui:VisualElement class="tactical-row">
                    <ui:Button name="capture-button" class="tool" text="Hold control point" />
                    <ui:Button name="assign-defender-button" class="tool" text="Make defender" />
                    <ui:Button name="end-turn-button" class="tool primary" text="End turn  [Space]" />
                    <ui:Button name="retreat-button" class="tool danger" text="Retreat" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="status-label" class="status-label" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="resource-bar" class="resource-bar" picking-mode="Ignore" />

        <ui:VisualElement name="milestone-toast" class="milestone-toast" picking-mode="Ignore">
            <ui:Label name="milestone-title" class="milestone-title" text="" picking-mode="Ignore" />
            <ui:Label name="milestone-detail" class="milestone-detail" text="" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="place-recipe" class="panel place-recipe">
            <ui:Label name="place-recipe-title" class="panel-subtitle" text="NEW MACHINES MAKE" />
            <ui:VisualElement name="place-recipe-list" class="place-recipe-list" />
        </ui:VisualElement>

        <ui:VisualElement name="production-panel" class="panel production-panel">
            <ui:VisualElement class="production-head">
                <ui:Label class="panel-subtitle production-title" text="PRODUCTION  ·  PER MINUTE" />
                <ui:Button name="production-close" class="tool production-close" text="Close [P]" />
            </ui:VisualElement>
            <ui:Label name="production-summary" class="body-text production-summary" text="" />
            <ui:VisualElement class="production-row production-header">
                <ui:Label class="production-cell production-name" text="Item" />
                <ui:Label class="production-cell" text="Made" />
                <ui:Label class="production-cell" text="Used" />
                <ui:Label class="production-cell" text="Sold" />
                <ui:Label class="production-cell" text="Spare" />
            </ui:VisualElement>
            <ui:ScrollView name="production-list" class="production-list" />
        </ui:VisualElement>

        <ui:VisualElement name="dock" class="dock">
            <ui:Button name="dock-build" class="tool dock-button" text="Build" />
            <ui:Button name="dock-info" class="tool dock-button" text="Info" />
            <ui:Button name="dock-alerts" class="tool dock-button" text="Alerts" />
            <ui:Button name="dock-network" class="tool dock-button" text="Network" />
        </ui:VisualElement>

        <ui:VisualElement name="touch-bar" class="touch-bar">
            <ui:Button name="touch-cancel" class="tool touch-button" text="Cancel" />
            <ui:Button name="touch-rotate" class="tool touch-button" text="Rotate" />
            <ui:Button name="touch-group" class="tool touch-button" text="Group" />
            <ui:Button name="touch-tilt-up" class="tool touch-button" text="Tilt up" />
            <ui:Button name="touch-tilt-down" class="tool touch-button" text="Tilt down" />
            <ui:Button name="touch-top" class="tool touch-button" text="Top view" />
            <ui:Button name="touch-reset" class="tool touch-button" text="Reset view" />
        </ui:VisualElement>
        <ui:VisualElement name="press-ring" class="press-ring" picking-mode="Ignore" />
        <ui:VisualElement name="select-box" class="select-box" picking-mode="Ignore" />

        <ui:VisualElement name="menu-overlay" class="result-overlay">
            <ui:VisualElement class="result-card menu-card">
                <ui:Label name="menu-title" class="result-title" text="Paused" />
                <ui:VisualElement class="result-buttons">
                    <ui:Button name="menu-resume" class="tool primary big" text="Resume" />
                    <ui:Button name="menu-save" class="tool big" text="Save now" />
                    <ui:Button name="menu-restart" class="tool danger big" text="Restart game" />
                    <ui:Button name="help-index" class="tool big help-wire" text="How to play" />
                </ui:VisualElement>
                <ui:Label name="menu-status" class="body-text small menu-status" text="" />

                <ui:Label class="panel-subtitle menu-section" text="SOUND" />
                <ui:Slider name="sfx-volume" class="menu-slider" label="Effects volume" low-value="0" high-value="1" />
                <ui:Slider name="music-volume" class="menu-slider" label="Music volume" low-value="0" high-value="1" />
                <ui:Toggle name="mute-toggle" class="menu-toggle" label="Mute all sound" />

                <ui:Label class="panel-subtitle menu-section" text="GAME" />
                <ui:VisualElement class="speed-row">
                    <ui:Label class="menu-label" text="Factory speed" />
                    <ui:Button name="speed-1" class="tool speed-button" text="1x" />
                    <ui:Button name="speed-2" class="tool speed-button" text="2x" />
                    <ui:Button name="speed-4" class="tool speed-button" text="4x" />
                </ui:VisualElement>
                <ui:VisualElement class="speed-row">
                    <ui:Label class="menu-label" text="Battle scenes" />
                    <ui:Button name="battle-0" class="tool speed-button" text="Off" />
                    <ui:Button name="battle-1" class="tool speed-button" text="Fast" />
                    <ui:Button name="battle-2" class="tool speed-button" text="Full" />
                </ui:VisualElement>
                <ui:VisualElement class="speed-row">
                    <ui:Label class="menu-label" text="AI battle turns" />
                    <ui:Button name="ai-turns-0" class="tool speed-button" text="Watch" />
                    <ui:Button name="ai-turns-1" class="tool speed-button" text="Quick" />
                    <ui:Button name="ai-turns-2" class="tool speed-button" text="Instant" />
                </ui:VisualElement>
                <ui:Slider name="pan-speed" class="menu-slider" label="Camera pan speed" low-value="0.25" high-value="3" />
                <ui:VisualElement class="speed-row">
                    <ui:Label class="menu-label" text="Machine needs" />
                    <ui:Button name="needs-0" class="tool speed-button visual-button" text="Always" />
                    <ui:Button name="needs-1" class="tool speed-button visual-button" text="On hover" />
                    <ui:Button name="needs-2" class="tool speed-button visual-button" text="Never" />
                </ui:VisualElement>
                <ui:VisualElement class="speed-row">
                    <ui:Label class="menu-label" text="Two-finger twist turns" />
                    <ui:Button name="twist-board" class="tool speed-button visual-button" text="The board" />
                    <ui:Button name="twist-camera" class="tool speed-button visual-button" text="The camera" />
                </ui:VisualElement>
                <ui:VisualElement class="speed-row">
                    <ui:Label class="menu-label" text="Graphics" />
                    <ui:Button name="graphics-0" class="tool speed-button" text="Auto" />
                    <ui:Button name="graphics-1" class="tool speed-button" text="High" />
                    <ui:Button name="graphics-2" class="tool speed-button" text="Low" />
                </ui:VisualElement>
                <ui:VisualElement class="speed-row">
                    <ui:Label class="menu-label" text="Layout" />
                    <ui:Button name="layout-0" class="tool speed-button" text="Auto" />
                    <ui:Button name="layout-1" class="tool speed-button" text="Full" />
                    <ui:Button name="layout-2" class="tool speed-button" text="Compact" />
                </ui:VisualElement>
                <ui:VisualElement class="speed-row">
                    <ui:Label class="menu-label" text="Interface size" />
                    <ui:Button name="uiscale-0" class="tool speed-button" text="Auto" />
                    <ui:Button name="uiscale-1" class="tool speed-button" text="100%" />
                    <ui:Button name="uiscale-2" class="tool speed-button" text="125%" />
                    <ui:Button name="uiscale-3" class="tool speed-button" text="150%" />
                    <ui:Button name="uiscale-4" class="tool speed-button" text="175%" />
                </ui:VisualElement>
                <ui:VisualElement class="speed-row">
                    <ui:Label class="menu-label" text="FPS readout" />
                    <ui:Button name="perf-0" class="tool speed-button visual-button" text="Off" />
                    <ui:Button name="perf-1" class="tool speed-button visual-button" text="Rates" />
                    <ui:Button name="perf-2" class="tool speed-button visual-button" text="Detailed" />
                </ui:VisualElement>
                <ui:VisualElement class="speed-row">
                    <ui:Label class="menu-label" text="Belt item icons" />
                    <ui:Button name="belt-icons-show" class="tool speed-button visual-button" text="Show" />
                    <ui:Button name="belt-icons-hide" class="tool speed-button visual-button" text="Hide" />
                </ui:VisualElement>
                <ui:VisualElement class="speed-row">
                    <ui:Label class="menu-label" text="Bottleneck markers" />
                    <ui:Button name="bottlenecks-show" class="tool speed-button visual-button" text="Show" />
                    <ui:Button name="bottlenecks-hide" class="tool speed-button visual-button" text="Hide" />
                </ui:VisualElement>

                <ui:Label class="panel-subtitle menu-section" text="VISUALS" />
                <ui:VisualElement class="speed-row">
                    <ui:Label class="menu-label" text="Visual style" />
                    <ui:Button name="visual-0" class="tool speed-button visual-button" text="Light weight" />
                    <ui:Button name="visual-1" class="tool speed-button visual-button" text="Meshy" />
                </ui:VisualElement>
                <ui:Label name="visual-note" class="body-text small" text="" />

                <ui:Label class="panel-subtitle menu-section" text="CONTROLS" />
                <ui:Label name="controls-text" class="body-text small" text="Left-click select / place  ·  Right-click order selected unit  ·  1-9 build tools  ·  B belts (drag)  ·  X dismantle  ·  WASD / right-drag pan  ·  Q/E or middle-drag rotate  ·  R/F tilt  ·  T top-down  ·  G ground view  ·  Wheel zoom  ·  Home reset view  ·  Space end battle turn  ·  Esc cancel / menu" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="config-window" class="panel config-window">
            <ui:VisualElement class="title-row">
                <ui:Label name="config-title" class="panel-title" text="SETTINGS" />
                <ui:Button name="config-close" class="panel-toggle" text="Close  [Esc]" />
            </ui:VisualElement>
            <ui:ScrollView name="config-body" class="config-body">
                <ui:Label name="working-on-title" class="panel-subtitle" text="WORKING ON" />
                <ui:VisualElement name="recipe-panel" class="choice-list" />
            </ui:ScrollView>
            <ui:VisualElement name="config-actions" class="config-actions">
                <ui:Button name="config-copy" class="tool" text="Copy settings  [Ctrl+C]" />
                <ui:Button name="config-paste" class="tool" text="Paste settings  [Ctrl+V]" />
            </ui:VisualElement>
            <ui:Label name="config-clipboard" class="body-text small" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="research-overlay" class="research-overlay">
            <ui:VisualElement class="research-header">
                <ui:Label class="research-title" text="RESEARCH" />
                <ui:Label name="research-funds" class="stat stat-currency" text="" />
                <ui:VisualElement class="spacer" picking-mode="Ignore" />
                <ui:Label class="body-text small" text="The game is paused while you research" />
                <ui:Button name="help-research" class="help-q help-wire" text="?" />
                <ui:Button name="research-close" class="tool menu-button" text="Close [Esc]" />
            </ui:VisualElement>
            <ui:VisualElement class="research-body">
                <ui:VisualElement name="research-web" class="research-web" />
                <ui:VisualElement name="research-detail" class="panel research-detail">
                    <ui:Label name="research-node-branch" class="panel-subtitle" text="" />
                    <ui:Label name="research-node-name" class="research-node-title" text="" />
                    <ui:Label name="research-node-state" class="body-text small" text="" />
                    <ui:VisualElement name="research-node-pips" class="research-pips" />
                    <ui:Label name="research-node-text" class="body-text" text="" />
                    <ui:Label name="research-node-cost" class="research-cost" text="" />
                    <ui:Button name="research-buy" class="tool primary big" text="Research" />
                    <ui:Label name="research-node-owned" class="body-text small" text="" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="title-overlay" class="title-overlay">
            <ui:VisualElement name="title-stars" class="title-stars" picking-mode="Ignore" />
            <ui:VisualElement class="title-content">
                <ui:VisualElement name="title-art" class="title-art" picking-mode="Ignore" />
                <ui:Label class="title-logo" text="ORBITAL FOUNDRY" />
                <ui:Label class="title-tagline" text="Mine the asteroids  ·  Power the foundry  ·  Take the frontier" />
                <ui:Label name="title-notice" class="title-notice" text="" />
                <ui:VisualElement name="title-difficulty" class="title-difficulty">
                    <ui:Label class="menu-label title-difficulty-label" text="New game difficulty" />
                    <ui:Button name="difficulty-0" class="tool speed-chip" text="Easy" />
                    <ui:Button name="difficulty-1" class="tool speed-chip" text="Medium" />
                    <ui:Button name="difficulty-2" class="tool speed-chip" text="Hard" />
                </ui:VisualElement>
                <ui:VisualElement class="title-buttons">
                    <ui:Button name="title-resume" class="tool primary big title-button" text="Resume saved game" />
                    <ui:Button name="title-new" class="tool big title-button" text="New game" />
                    <ui:Button name="title-test" class="tool big title-button" text="Test: mid-game" />
                    <ui:Button name="title-settings" class="tool big title-button" text="Settings" />
                    <ui:Button name="help-getting_started" class="tool big title-button help-wire" text="How to play" />
                </ui:VisualElement>
                <ui:Label name="title-footer" class="title-footer" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="help-popup" class="help-popup">
            <ui:VisualElement class="help-header">
                <ui:Label name="help-title" class="help-title" text="" />
                <ui:Button name="help-close" class="tool help-close" text="Close" />
            </ui:VisualElement>
            <ui:Label name="help-summary" class="help-summary" text="" />
            <ui:ScrollView name="help-body" class="help-body" />
            <ui:VisualElement name="help-related" class="help-related" />
        </ui:VisualElement>

        <ui:VisualElement name="result-overlay" class="result-overlay">
            <ui:VisualElement class="result-card">
                <ui:Label name="result-title" class="result-title" text="Orbital Foundry" />
                <ui:Label name="result-text" class="result-text" text="" />
                <ui:VisualElement class="result-buttons">
                    <ui:Button name="resume-button" class="tool primary big" text="Resume saved game" />
                    <ui:Button name="continue-button" class="tool primary big" text="Keep building" />
                    <ui:Button name="new-game-button" class="tool big" text="New game" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">

        <ui:VisualElement name="top-bar" class="top-bar">
            <ui:Label name="currency-label" class="stat stat-currency" text="Credits: 0" />
            <ui:Label name="sales-label" class="stat" text="Sales: 0 / 0" />
            <ui:Label name="goal-label" class="stat goal" text="Goals: Sales not yet  ·  AI HQ standing" />
            <ui:VisualElement class="spacer" picking-mode="Ignore" />
            <ui:Label name="save-indicator" class="save-indicator" text="Not saved yet" />
            <ui:Label name="speed-label" class="speed-label" text="" />
            <ui:Button name="menu-button" class="tool menu-button" text="Menu [Esc]" />
        </ui:VisualElement>

        <ui:VisualElement name="tactical-banner" class="tactical-banner">
            <ui:Label text="BATTLE - FACTORY PRODUCTION PAUSED" class="tactical-banner-text" />
        </ui:VisualElement>

        <ui:VisualElement class="columns" picking-mode="Ignore">
            <ui:VisualElement name="left-column" class="column left-column" picking-mode="Ignore">
                <ui:VisualElement name="build-panel" class="panel">
                    <ui:Label text="BUILD" class="panel-title" />
                    <ui:Button name="select-tool" class="tool" text="Select  [Esc]" />
                    <ui:Button name="build-extractor" class="tool" text="Extractor" />
                    <ui:Button name="build-refinery" class="tool" text="Refinery" />
                    <ui:Button name="build-assembler" class="tool" text="Assembler" />
                    <ui:Button name="build-depot" class="tool" text="Sale Depot" />
                    <ui:Button name="build-shipyard" class="tool" text="Shipyard" />
                    <ui:Button name="belt-tool" class="tool" text="Belt (drag)" />
                    <ui:Button name="dismantle-tool" class="tool danger" text="Dismantle  [X]" />
                </ui:VisualElement>
                <ui:VisualElement name="invest-panel" class="panel">
                    <ui:Label text="INVEST" class="panel-title" />
                    <ui:Button name="upgrade-button" class="tool" text="Brokerage Contract" />
                    <ui:Button name="tech-button" class="tool" text="Quantum License" />
                </ui:VisualElement>
                <ui:VisualElement name="craft-panel" class="panel">
                    <ui:Label text="ORDER CRAFT (at selected shipyard)" class="panel-title" />
                    <ui:Label name="craft-hint" class="body-text small" text="Select one of your shipyards." />
                    <ui:Button name="buy-tank" class="tool" text="Tank" />
                    <ui:Button name="buy-artillery" class="tool" text="Artillery" />
                    <ui:Button name="buy-guard" class="tool" text="Mobile Guard" />
                    <ui:Button name="buy-strike" class="tool" text="Strike Craft" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="spacer" picking-mode="Ignore" />

            <ui:VisualElement name="right-column" class="column right-column" picking-mode="Ignore">
                <ui:VisualElement name="selection-panel" class="panel">
                    <ui:Label text="SELECTION" class="panel-title" />
                    <ui:Label name="selected-cell-label" class="body-text" text="Nothing selected. Click a cell, machine or craft." />
                    <ui:Label name="selection-details" class="body-text small" text="" />
                    <ui:Label name="working-on-title" class="panel-subtitle" text="WORKING ON" />
                    <ui:VisualElement name="recipe-panel" class="choice-list" />
                    <ui:Label name="needs-title" class="panel-subtitle" text="NEEDS" />
                    <ui:VisualElement name="needs-list" class="needs-list" />
                    <ui:VisualElement name="craft-list" class="craft-list" />
                    <ui:Label name="selected-craft-stats" class="stats-text" text="" />
                    <ui:VisualElement name="craft-orders" class="craft-orders">
                        <ui:Label text="UNIT ORDERS" class="panel-subtitle" />
                        <ui:Label name="craft-order-hint" class="body-text small" text="" />
                        <ui:Button name="claim-button" class="tool primary" text="Claim this cell" />
                    </ui:VisualElement>
                    <ui:Button name="dismantle-button" class="tool danger" text="Dismantle" />
                </ui:VisualElement>
                <ui:VisualElement name="alert-panel" class="panel">
                    <ui:Label text="ALERTS" class="panel-title" />
                    <ui:ScrollView name="alert-list" class="alert-list" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="bottom-area" class="bottom-area" picking-mode="Ignore">
            <ui:VisualElement name="tactical-panel" class="panel tactical-panel">
                <ui:VisualElement class="tactical-row">
                    <ui:Label name="turn-label" class="turn-label" text="Your turn" />
                    <ui:Label name="action-label" class="action-label" text="Actions: 3" />
                </ui:VisualElement>
                <ui:Label name="attack-preview" class="preview-text" text="Select one of your craft, then hover an enemy cell to preview an attack." />
                <ui:VisualElement name="pending-defender" class="pending-defender" />
                <ui:VisualElement class="tactical-row">
                    <ui:Button name="capture-button" class="tool" text="Hold control point" />
                    <ui:Button name="assign-defender-button" class="tool" text="Make defender" />
                    <ui:Button name="end-turn-button" class="tool primary" text="End turn  [Space]" />
                    <ui:Button name="retreat-button" class="tool danger" text="Retreat" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="status-label" class="status-label" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="menu-overlay" class="result-overlay">
            <ui:VisualElement class="result-card menu-card">
                <ui:Label class="result-title" text="Paused" />
                <ui:VisualElement class="result-buttons">
                    <ui:Button name="menu-resume" class="tool primary big" text="Resume" />
                    <ui:Button name="menu-save" class="tool big" text="Save now" />
                    <ui:Button name="menu-restart" class="tool danger big" text="Restart game" />
                </ui:VisualElement>
                <ui:Label name="menu-status" class="body-text small menu-status" text="" />

                <ui:Label class="panel-subtitle menu-section" text="SOUND" />
                <ui:Slider name="sfx-volume" class="menu-slider" label="Effects volume" low-value="0" high-value="1" />
                <ui:Toggle name="mute-toggle" class="menu-toggle" label="Mute all sound" />

                <ui:Label class="panel-subtitle menu-section" text="GAME" />
                <ui:VisualElement class="speed-row">
                    <ui:Label class="menu-label" text="Factory speed" />
                    <ui:Button name="speed-1" class="tool speed-button" text="1x" />
                    <ui:Button name="speed-2" class="tool speed-button" text="2x" />
                    <ui:Button name="speed-4" class="tool speed-button" text="4x" />
                </ui:VisualElement>
                <ui:Slider name="pan-speed" class="menu-slider" label="Camera pan speed" low-value="0.25" high-value="3" />
                <ui:Toggle name="need-icons-toggle" class="menu-toggle" label="Show ingredient icons over machines" />

                <ui:Label class="panel-subtitle menu-section" text="CONTROLS" />
                <ui:Label class="body-text small" text="Left-click select / place  ·  Right-click order selected unit  ·  1-5 build tools  ·  B belts (drag)  ·  X dismantle  ·  WASD / right-drag pan  ·  Wheel or Q/E zoom  ·  Space end battle turn  ·  Esc cancel / menu" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="result-overlay" class="result-overlay">
            <ui:VisualElement class="result-card">
                <ui:Label name="result-title" class="result-title" text="Orbital Foundry" />
                <ui:Label name="result-text" class="result-text" text="" />
                <ui:VisualElement class="result-buttons">
                    <ui:Button name="resume-button" class="tool primary big" text="Resume saved game" />
                    <ui:Button name="continue-button" class="tool primary big" text="Keep building" />
                    <ui:Button name="new-game-button" class="tool big" text="New game" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

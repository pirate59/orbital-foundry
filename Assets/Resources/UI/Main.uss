/* Comet Garden: aubergine space, moonstone panels, mint actions and warm starlight. */
.hud-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: column;
    color: rgb(246, 232, 232);
    font-size: 15px;
}

.top-bar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    background-color: rgba(22, 14, 40, 0.94);
    border-bottom-width: 1px;
    border-bottom-color: rgb(114, 92, 140);
}
.stat { margin-right: 22px; -unity-font-style: bold; font-size: 17px; }
.stat-currency { color: rgb(255, 222, 126); }
.goal { color: rgb(169, 232, 213); }
.goal-done { color: rgb(151, 247, 200); }
.save-indicator { font-size: 13px; color: rgb(190, 169, 205); }
.save-error { color: rgb(255, 120, 110); -unity-font-style: bold; }
.spacer { flex-grow: 1; }

.tactical-banner {
    display: none;
    background-color: rgba(150, 40, 40, 0.88);
    padding: 4px;
    align-items: center;
}
.tactical-banner-text { -unity-font-style: bold; font-size: 16px; color: rgb(255, 235, 220); }

.columns { flex-direction: row; flex-grow: 1; padding: 10px; }
.column { width: 270px; flex-direction: column; }
.selection-panel { flex-grow: 1; min-height: 0; }
.linked-entity { height: 27px; font-size: 12px; color: rgb(169, 232, 213); }

.panel {
    background-color: rgba(34, 24, 54, 0.92);
    border-width: 1px;
    border-color: rgb(112, 86, 137);
    border-radius: 9px;
    padding: 8px;
    margin-bottom: 10px;
}
.panel-title { font-size: 12px; color: rgb(204, 177, 218); -unity-font-style: bold; margin-bottom: 4px; letter-spacing: 1px; }
.body-text { white-space: normal; margin-bottom: 4px; }
.small { font-size: 13px; color: rgb(199, 182, 211); }
.stats-text { white-space: normal; font-size: 13px; color: rgb(229, 214, 232); }

.tool {
    height: 32px;
    margin: 2px 0;
    -unity-text-align: middle-left;
    padding-left: 10px;
    background-color: rgb(58, 42, 82);
    color: rgb(246, 232, 232);
    border-width: 1px;
    border-color: rgb(124, 97, 149);
    border-radius: 6px;
    font-size: 14px;
}
.tool:hover { background-color: rgb(76, 55, 105); }
.tool:active { background-color: rgb(88, 67, 116); }
.tool:disabled { background-color: rgb(35, 29, 48); color: rgb(128, 111, 143); border-color: rgb(69, 56, 82); }
.tool-active { background-color: rgb(62, 130, 119); border-color: rgb(151, 247, 200); -unity-font-style: bold; }
.primary { background-color: rgb(53, 113, 99); border-color: rgb(151, 247, 200); }
.primary:hover { background-color: rgb(67, 140, 120); }
.danger { background-color: rgb(110, 36, 40); border-color: rgb(200, 90, 90); }
.danger:hover { background-color: rgb(140, 46, 52); }
.big { height: 42px; font-size: 17px; -unity-text-align: middle-center; margin: 4px 6px; padding: 0 18px; }

.button-row { flex-direction: row; flex-wrap: wrap; }
.button-row .tool { margin-right: 4px; flex-grow: 1; }
.craft-list { flex-direction: column; }
.craft-list .tool { height: 28px; font-size: 13px; }

.alert-list { max-height: 260px; }
.alert { white-space: normal; font-size: 13px; padding: 4px 6px; margin-bottom: 3px; border-radius: 3px; background-color: rgba(63, 43, 82, 0.85); }
.alert-raid { background-color: rgba(140, 50, 30, 0.9); color: rgb(255, 225, 200); -unity-font-style: bold; }
.alert-blocked { background-color: rgba(120, 100, 20, 0.85); }
.alert-error { background-color: rgba(150, 30, 30, 0.95); }
.alert-victory { background-color: rgba(30, 120, 70, 0.9); -unity-font-style: bold; }

.bottom-area { align-items: center; padding-bottom: 10px; }
.tactical-panel { display: none; width: 720px; }
.tactical-row { flex-direction: row; align-items: center; }
.tactical-row .tool { flex-grow: 1; margin-right: 4px; -unity-text-align: middle-center; padding-left: 0; }
.turn-label { font-size: 18px; -unity-font-style: bold; flex-grow: 1; }
.turn-ai { color: rgb(255, 177, 153); }
.action-label { font-size: 16px; color: rgb(255, 222, 126); }
.preview-text { white-space: normal; font-size: 14px; margin: 4px 0; color: rgb(233, 218, 236); }
.pending-defender { flex-direction: row; flex-wrap: wrap; }
.pending-defender .tool { background-color: rgb(140, 100, 20); margin-right: 4px; }
.status-label {
    font-size: 15px;
    background-color: rgba(22, 14, 40, 0.9);
    padding: 4px 12px;
    border-radius: 4px;
    white-space: normal;
    max-width: 900px;
}
.status-error { color: rgb(255, 140, 120); }
.visual-button { width: 124px; }

/* Resource bar: core resources held across the player's network */
.resource-bar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-height: 26px;
    padding: 1px 12px;
    background-color: rgba(22, 14, 40, 0.94);
    border-top-width: 1px;
    border-top-color: rgb(114, 92, 140);
}
.resource-title { font-size: 10px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(169, 232, 213); margin-right: 10px; }
/* One line per resource, with fixed-width number slots so growing counts never shift their neighbours. */
.resource-chip { flex-direction: row; align-items: center; margin-right: 14px; height: 24px; }
.resource-icon { width: 18px; height: 18px; margin-right: 4px; -unity-background-scale-mode: scale-to-fit; border-radius: 3px; flex-shrink: 0; }
.resource-name { font-size: 11px; color: rgb(199, 182, 211); margin-right: 4px; }
.resource-count { font-size: 14px; -unity-font-style: bold; color: rgb(246, 232, 232); width: 54px; -unity-text-align: middle-right; flex-shrink: 0; }
.resource-empty { color: rgb(130, 112, 150); }
.resource-moving { font-size: 10px; color: rgb(151, 247, 200); width: 40px; margin-left: 3px; -unity-text-align: middle-left; flex-shrink: 0; }

.result-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(13, 8, 27, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}
.result-card {
    width: 620px;
    padding: 24px;
    background-color: rgb(35, 25, 56);
    border-width: 2px;
    border-color: rgb(155, 130, 177);
    border-radius: 10px;
    align-items: center;
}
.result-title { font-size: 34px; -unity-font-style: bold; margin-bottom: 12px; color: rgb(201, 242, 222); }
.result-text { white-space: normal; font-size: 16px; margin-bottom: 18px; -unity-text-align: middle-center; }
.result-buttons { flex-direction: row; justify-content: center; flex-wrap: wrap; }

/* Building choices and needs */
.panel-subtitle { font-size: 11px; color: rgb(204, 177, 218); -unity-font-style: bold; margin-top: 6px; margin-bottom: 2px; letter-spacing: 1px; }
.choice-list { flex-direction: column; }
.choice-list .tool { height: auto; min-height: 30px; white-space: normal; padding-top: 4px; padding-bottom: 4px; font-size: 13px; }
.choice-active { background-color: rgb(62, 130, 119); border-color: rgb(151, 247, 200); -unity-font-style: bold; }
.choice-off { color: rgb(160, 143, 174); background-color: rgb(41, 31, 59); }
.needs-list { flex-direction: column; }
.need-row { flex-direction: row; align-items: center; padding: 3px 4px; margin-bottom: 2px; border-radius: 3px; border-left-width: 4px; }
.need-swatch { width: 14px; height: 14px; border-radius: 7px; margin-right: 6px; border-width: 1px; border-color: rgba(0, 0, 0, 0.6); }
.need-text { white-space: normal; font-size: 13px; flex-shrink: 1; }
.need-ok { background-color: rgba(30, 90, 60, 0.6); border-left-color: rgb(90, 220, 140); }
.need-coming { background-color: rgba(110, 90, 20, 0.6); border-left-color: rgb(255, 200, 80); }
.need-missing { background-color: rgba(130, 30, 30, 0.75); border-left-color: rgb(255, 90, 80); }

/* Menu */
.menu-button { width: 110px; margin-left: 12px; -unity-text-align: middle-center; padding-left: 0; }
.speed-label { margin-left: 12px; color: rgb(255, 222, 126); -unity-font-style: bold; }
.menu-card { width: 640px; align-items: stretch; }
.menu-card .result-title { -unity-text-align: middle-center; }
.menu-status { -unity-text-align: middle-center; min-height: 18px; }
.menu-section { margin-top: 12px; }
.menu-slider, .menu-toggle { margin: 4px 0; }
.menu-slider Label, .menu-toggle Label, .menu-label { color: rgb(246, 232, 232); min-width: 200px; font-size: 14px; }
.speed-row { flex-direction: row; align-items: center; }
.speed-button { width: 70px; margin-right: 6px; -unity-text-align: middle-center; padding-left: 0; }

/* Research web (opened from the HQ) */
.research-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(13, 8, 27, 0.96);
    flex-direction: column;
    display: none;
}
.research-header {
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding: 0 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(114, 92, 140);
    background-color: rgba(22, 14, 40, 0.98);
}
.research-title { font-size: 20px; -unity-font-style: bold; letter-spacing: 3px; color: rgb(201, 242, 222); margin-right: 24px; }
.research-body { flex-direction: row; flex-grow: 1; min-height: 0; padding: 10px; }
.research-web {
    flex-grow: 1;
    overflow: hidden;
    border-width: 1px;
    border-color: rgb(112, 86, 137);
    border-radius: 9px;
    margin-right: 10px;
    background-color: rgb(20, 14, 38);
}
.research-world { position: absolute; left: 0; top: 0; width: 1px; height: 1px; overflow: visible; }
.research-links { position: absolute; left: 0; top: 0; width: 1px; height: 1px; overflow: visible; }
.research-lanes { position: absolute; left: 0; top: 0; width: 1px; height: 1px; overflow: visible; }
.research-lane {
    position: absolute;
    border-left-width: 4px;
    border-radius: 10px;
    padding: 5px 0 0 12px;
}
.research-lane-name { font-size: 11px; -unity-font-style: bold; letter-spacing: 2px; }
.research-controls {
    position: absolute;
    right: 10px; top: 10px;
    flex-direction: row;
    padding: 4px;
    border-radius: 8px;
    background-color: rgba(22, 14, 40, 0.92);
    border-width: 1px;
    border-color: rgb(112, 86, 137);
}
.research-control {
    min-width: 34px; height: 30px;
    margin: 0 2px;
    padding: 0 8px;
    font-size: 16px;
    -unity-font-style: bold;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(124, 97, 149);
    background-color: rgb(46, 34, 70);
    color: rgb(246, 232, 232);
}
.research-control:hover { background-color: rgb(66, 50, 96); }
.research-hint {
    position: absolute;
    left: 12px; bottom: 8px;
    font-size: 12px;
    color: rgb(170, 152, 190);
    padding: 3px 8px;
    border-radius: 6px;
    background-color: rgba(22, 14, 40, 0.85);
}
.research-leads { margin-top: 8px; color: rgb(201, 242, 222); }
.research-detail { width: 300px; margin-bottom: 0; }
.research-node-title { font-size: 22px; -unity-font-style: bold; white-space: normal; margin-bottom: 2px; }
.research-cost { font-size: 15px; color: rgb(255, 222, 126); margin: 8px 0; -unity-font-style: bold; }
.research-pips { flex-direction: row; margin: 6px 0; }
.research-pip { width: 18px; height: 8px; margin-right: 4px; border-radius: 3px; border-width: 1px; border-color: rgb(124, 97, 149); background-color: rgb(41, 31, 59); }

.research-node {
    position: absolute;
    margin: 0;
    padding: 4px 8px;
    border-width: 2px;
    border-left-width: 6px;
    border-radius: 8px;
    background-color: rgb(46, 34, 70);
    border-color: rgb(124, 97, 149);
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
}
.research-node:hover { background-color: rgb(66, 50, 96); border-right-color: rgb(200, 186, 222); border-bottom-color: rgb(200, 186, 222); }
.research-web-dragging .research-node:hover { background-color: rgb(46, 34, 70); }
.research-node-name { font-size: 13px; -unity-font-style: bold; white-space: normal; color: rgb(246, 232, 232); }
.research-node-sub { font-size: 11px; color: rgb(199, 182, 211); }
.research-node-mark { font-size: 22px; -unity-font-style: bold; color: rgb(150, 130, 175); }
.research-affordable { background-color: rgb(42, 88, 80); }
.research-affordable:hover { background-color: rgb(53, 113, 99); }
.research-unaffordable { opacity: 0.85; }
.research-owned { background-color: rgb(58, 46, 90); }
.research-maxed { background-color: rgb(70, 58, 34); }
.research-maxed .research-node-sub { color: rgb(255, 222, 126); }
.research-hinted {
    background-color: rgba(30, 22, 48, 0.6);
    border-color: rgb(80, 66, 104);
    opacity: 0.8;
    align-items: center;
}
.research-node.research-selected {
    border-right-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-right-width: 3px; border-bottom-width: 3px; border-top-width: 3px;
    scale: 1.06 1.06;
}
.research-affordable { border-right-color: rgb(151, 247, 200); border-bottom-color: rgb(151, 247, 200); }

/* Help: small "?" buttons and the info-bite popup */
.help-q {
    width: 22px; height: 22px;
    min-width: 22px;
    margin: 0 0 0 4px;
    padding: 0;
    border-radius: 11px;
    border-width: 1px;
    border-color: rgb(151, 247, 200);
    background-color: rgb(40, 74, 72);
    color: rgb(201, 242, 222);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.help-q:hover { background-color: rgb(62, 130, 119); }
.stat-tight { margin-right: 6px; }
.stat-help { margin-right: 22px; }
.title-row { flex-direction: row; align-items: center; justify-content: space-between; }
.tool-row { flex-direction: row; align-items: center; }
.priority-row { flex-direction: row; margin-top: 2px; }
.priority-button { flex-grow: 1; flex-basis: 0; font-size: 10px; margin: 1px; padding: 3px 0; border-radius: 3px; }
.priority-button.priority-active { background-color: rgb(92, 193, 160); color: rgb(16, 10, 30); -unity-font-style: bold; }
.tool-row .tool { flex-grow: 1; }
.help-popup {
    position: absolute;
    right: 300px;
    top: 70px;
    width: 440px;
    max-height: 75%;
    padding: 14px;
    background-color: rgb(35, 25, 56);
    border-width: 2px;
    border-color: rgb(151, 247, 200);
    border-radius: 10px;
    display: none;
}
.help-header { flex-direction: row; align-items: center; justify-content: space-between; }
.help-title { font-size: 21px; -unity-font-style: bold; color: rgb(201, 242, 222); white-space: normal; flex-shrink: 1; }
.help-close { width: 70px; -unity-text-align: middle-center; padding-left: 0; }
.help-summary { white-space: normal; font-size: 14px; color: rgb(255, 222, 126); margin: 6px 0 4px 0; }
.help-body { flex-shrink: 1; min-height: 0; }
.help-heading { font-size: 13px; -unity-font-style: bold; color: rgb(204, 177, 218); margin-top: 8px; letter-spacing: 1px; }
.help-text { white-space: normal; font-size: 14px; color: rgb(236, 224, 236); }
.help-related { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.help-link { height: 26px; margin: 2px 4px 2px 0; padding: 0 10px; font-size: 12px; border-radius: 13px; background-color: rgb(58, 42, 82); color: rgb(169, 232, 213); border-width: 1px; border-color: rgb(124, 97, 149); }
.help-link:hover { background-color: rgb(76, 55, 105); }

/* Title screen */
.title-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(16, 10, 30);
    align-items: center;
    justify-content: center;
    display: none;
}
.title-stars { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.title-star { position: absolute; border-radius: 2px; }
.title-content { align-items: center; max-width: 900px; padding: 20px; }
.title-art { flex-direction: row; align-items: flex-end; justify-content: center; height: 170px; margin-bottom: 10px; }
.title-sprite { margin: 0 6px; }
.title-logo { font-size: 64px; -unity-font-style: bold; letter-spacing: 10px; color: rgb(201, 242, 222); -unity-text-align: middle-center; }
.title-tagline { font-size: 17px; letter-spacing: 3px; color: rgb(255, 177, 153); margin-top: 6px; -unity-text-align: middle-center; }
.title-notice { white-space: normal; font-size: 14px; color: rgb(255, 222, 126); margin-top: 14px; max-width: 620px; -unity-text-align: middle-center; }
.title-buttons { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 26px; }
.title-button { min-width: 200px; }
.title-footer { white-space: normal; font-size: 13px; color: rgb(170, 152, 190); margin-top: 26px; max-width: 620px; -unity-text-align: middle-center; }

/* Battle scenes */
.battle-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(8, 5, 16, 0.82);
    align-items: center;
    justify-content: center;
}
.battle-stage { flex-shrink: 0; overflow: hidden; border-width: 2px; border-color: rgb(112, 86, 137); border-radius: 12px; background-color: rgb(11, 7, 22); }
.battle-half { position: absolute; top: 0; bottom: 0; width: 480px; overflow: hidden; }
.battle-left { left: 0; }
.battle-right { right: 0; }
.battle-player { background-color: rgb(16, 33, 36); }
.battle-enemy { background-color: rgb(36, 18, 32); }
.battle-star { position: absolute; width: 2px; height: 2px; background-color: rgb(164, 124, 161); }
.battle-deck { position: absolute; left: 38px; right: 38px; bottom: 70px; height: 86px; border-radius: 200px; border-width: 2px; }
.battle-player .battle-deck { border-color: rgb(92, 193, 160); background-color: rgb(30, 60, 56); }
.battle-enemy .battle-deck { border-color: rgb(217, 142, 120); background-color: rgb(66, 36, 46); }
.battle-ship { position: absolute; }
.battle-plate { position: absolute; top: 18px; left: 20px; right: 20px; }
.battle-name-row { flex-direction: row; align-items: center; }
.battle-name { font-size: 18px; -unity-font-style: bold; letter-spacing: 2px; margin-right: 8px; }
.battle-badge { font-size: 11px; -unity-font-style: bold; color: rgb(16, 10, 30); background-color: rgb(255, 222, 126); padding: 1px 6px; border-radius: 3px; }
.battle-hp-row { flex-direction: row; align-items: center; margin-top: 4px; }
.battle-hp { font-size: 30px; -unity-font-style: bold; min-width: 110px; color: rgb(246, 232, 232); }
.battle-bar { flex-grow: 1; height: 12px; background-color: rgb(42, 31, 59); border-width: 1px; border-color: rgb(93, 74, 122); border-radius: 3px; overflow: hidden; }
.battle-bar-fill { height: 100%; }
.battle-divider { position: absolute; top: 0; bottom: 0; left: 477px; width: 6px; background-color: rgb(255, 222, 126); }
.battle-fx { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.battle-bolt { position: absolute; width: 28px; height: 4px; border-radius: 2px; }
.battle-pop { position: absolute; font-size: 44px; -unity-font-style: bold; color: rgb(255, 222, 126); }
.battle-callout {
    position: absolute;
    left: 330px; width: 300px; top: 200px;
    -unity-text-align: middle-center;
    font-size: 30px; -unity-font-style: bold; letter-spacing: 4px;
    padding: 6px 0;
    background-color: rgba(16, 10, 30, 0.88);
    border-width: 2px; border-radius: 6px;
}
.battle-log { position: absolute; left: 0; right: 0; bottom: 0; padding: 8px 14px; font-size: 15px; white-space: normal; background-color: rgba(16, 10, 30, 0.92); border-top-width: 1px; border-top-color: rgb(93, 74, 122); color: rgb(246, 232, 232); }
.battle-hint { margin-top: 10px; font-size: 13px; color: rgb(170, 152, 190); }

/* Power readout */
/* A fixed width, so the readout growing when power runs short never pushes the rest of the bar around. */
.stat-power { color: rgb(255, 222, 126); width: 360px; min-width: 360px; -unity-text-align: middle-left; overflow: hidden; }
.power-low { color: rgb(255, 125, 110); }

/* Collapsible panels */
.panel-toggle {
    height: 20px;
    margin: 0 0 4px 0;
    padding: 0 8px;
    font-size: 11px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(124, 97, 149);
    background-color: rgb(58, 42, 82);
    color: rgb(204, 177, 218);
}
.panel-toggle:hover { background-color: rgb(76, 55, 105); }
.panel-collapsed { flex-grow: 0; }
.belt-view-button { width: 130px; margin-left: 12px; -unity-text-align: middle-center; padding-left: 0; }

/* Building settings pop-up: a window over the board, beside the side bars. */
.config-window {
    position: absolute;
    top: 70px;
    left: 30%;
    width: 420px;
    max-height: 75%;
    display: none;
}
.config-body { flex-shrink: 1; }
.config-actions { flex-direction: row; margin-top: 6px; }
.config-actions .tool { flex-grow: 1; flex-basis: 0; margin-right: 4px; }

/* Testing overlay: FPS, TPS and stage costs (F3) */
.perf-overlay {
    position: absolute;
    left: 8px; bottom: 34px;
    padding: 3px 8px;
    border-radius: 5px;
    background-color: rgba(10, 6, 20, 0.78);
    color: rgb(151, 247, 200);
    font-size: 12px;
    white-space: normal;
}

/* Belt speed picker: opened by a long press on the Belt button */
.belt-tier-picker {
    position: absolute;
    padding: 8px;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgb(112, 86, 137);
    background-color: rgba(34, 24, 54, 0.97);
    min-width: 250px;
}
.belt-tier-picker .tool { margin: 2px 0; }
